@page
@model CambiarPasswordModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cambiar contrasena · Gestor Ruleta</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/gestor.css" />
    <script>
        // Antes de pintar, para evitar el destello del tema equivocado.
        document.documentElement.setAttribute('data-tema', localStorage.getItem('tema') || 'claro');
    </script>
</head>
<body>
    <button class="btn-tema-flotante" id="btnTemaFlotante" aria-label="Cambiar tema">
        <i class="bi bi-moon-stars" id="iconoTemaFlotante"></i>
    </button>

    <div class="pantalla-login">
        <div class="caja-login entra">
            
            <form method="post">
                <div class="login-marca"><span class="marca-disco"></span></div>
                <div class="login-titulo">Nueva contrasena</div>
                <p class="login-bajada">Por seguridad, elige una clave propia antes de continuar.</p>

                <div asp-validation-summary="ModelOnly" class="aviso aviso-error"></div>

                <div class="campo">
                    <label asp-for="Datos.Actual">Contrasena actual</label>
                    <input class="control" asp-for="Datos.Actual" type="password"
                           autocomplete="current-password" autofocus />
                    <span asp-validation-for="Datos.Actual" class="error-campo"></span>
                </div>

                <div class="campo">
                    <label asp-for="Datos.Nueva">Contrasena nueva</label>
                    <input class="control" asp-for="Datos.Nueva" type="password" autocomplete="new-password" />
                    <span asp-validation-for="Datos.Nueva" class="error-campo"></span>
                    <div class="ayuda">Minimo 8 caracteres.</div>
                </div>

                <div class="campo">
                    <label asp-for="Datos.Repetir">Repetir contrasena</label>
                    <input class="control" asp-for="Datos.Repetir" type="password" autocomplete="new-password" />
                    <span asp-validation-for="Datos.Repetir" class="error-campo"></span>
                </div>

                <button type="submit" class="btn btn-principal" style="width:100%;margin-top:6px">
                    <i class="bi bi-shield-check"></i> Guardar
                </button>
            </form>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <partial name="Shared/_ValidationScriptsPartial" />
    <script>
        (function () {
            const raiz  = document.documentElement;
            const icono = document.getElementById('iconoTemaFlotante');

            function pintar(tema) {
                raiz.setAttribute('data-tema', tema);
                localStorage.setItem('tema', tema);
                icono.className = tema === 'oscuro' ? 'bi bi-sun' : 'bi bi-moon-stars';
            }

            pintar(localStorage.getItem('tema') || 'claro');

            document.getElementById('btnTemaFlotante').onclick = () =>
                pintar(raiz.getAttribute('data-tema') === 'oscuro' ? 'claro' : 'oscuro');
        })();
    </script>
</body>
</html>
