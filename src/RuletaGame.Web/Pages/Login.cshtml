@page
@model LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ingresar · Gestor Ruleta</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/gestor.css" />
    <script>
        // Antes de pintar, para evitar el destello del tema equivocado.
        document.documentElement.setAttribute('data-tema', localStorage.getItem('tema') || 'claro');
    </script>
</head>
<body>
    <button class="btn-tema-flotante" id="btnTemaFlotante" aria-label="Cambiar tema">
        <i class="bi bi-moon-stars" id="iconoTemaFlotante"></i>
    </button>

    <div class="pantalla-login">
        <div class="caja-login entra">
            
            <div>
                <div class="login-marca"><span class="marca-disco"></span></div>
                <div class="login-titulo">Gestor Ruleta</div>
                <p class="login-bajada">Administra las ruletas de tus pedestales</p>

                @if (TempData["Mensaje"] is string mensaje)
                {
                    <div class="aviso aviso-ok"><i class="bi bi-check-circle-fill"></i> <span>@mensaje</span></div>
                }

                <div class="aviso aviso-error" id="avisoError" style="display:none">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span id="textoError"></span>
                </div>

                <div class="campo">
                    <label for="usuario">Usuario</label>
                    <input class="control" id="usuario" autocomplete="username" autofocus />
                </div>

                <div class="campo">
                    <label for="password">Contrasena</label>
                    <input class="control" id="password" type="password" autocomplete="current-password" />
                </div>

                <button class="btn btn-principal" id="btnIngresar" style="width:100%;margin-top:6px">
                    <i class="bi bi-box-arrow-in-right"></i> Ingresar
                </button>
            </div>
        </div>
    </div>

    <script>
        const volverA  = new URLSearchParams(location.search).get('volverA') || '/';
        const btn      = document.getElementById('btnIngresar');
        const aviso    = document.getElementById('avisoError');
        const texto    = document.getElementById('textoError');
        const usuario  = document.getElementById('usuario');
        const password = document.getElementById('password');

        function mostrarError(mensaje) {
            texto.textContent = mensaje;
            aviso.style.display = 'flex';
        }

        async function ingresar() {
            aviso.style.display = 'none';

            if (!usuario.value.trim() || !password.value) {
                mostrarError('Escribe tu usuario y contrasena.');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Verificando...';

            try {
                const respuesta = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ usuario: usuario.value.trim(), password: password.value })
                });

                const datos = await respuesta.json();

                if (!respuesta.ok) {
                    mostrarError(datos.mensaje || 'No se pudo ingresar.');
                    return;
                }

                location.href = datos.debeCambiarPassword ? '/CambiarPassword' : volverA;
            } catch {
                mostrarError('Sin conexion con el servidor.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-box-arrow-in-right"></i> Ingresar';
            }
        }

        btn.addEventListener('click', ingresar);
        [usuario, password].forEach(c =>
            c.addEventListener('keydown', e => { if (e.key === 'Enter') ingresar(); }));
    </script>
    <script>
        (function () {
            const raiz  = document.documentElement;
            const icono = document.getElementById('iconoTemaFlotante');

            function pintar(tema) {
                raiz.setAttribute('data-tema', tema);
                localStorage.setItem('tema', tema);
                icono.className = tema === 'oscuro' ? 'bi bi-sun' : 'bi bi-moon-stars';
            }

            pintar(localStorage.getItem('tema') || 'claro');

            document.getElementById('btnTemaFlotante').onclick = () =>
                pintar(raiz.getAttribute('data-tema') === 'oscuro' ? 'claro' : 'oscuro');
        })();
    </script>
</body>
</html>
